{
    "semi": false,
    "bracketSpacing": true,
    "singleQuote": true,
    "jsxSingleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 4,
    "arrowParens": "avoid",
    "importOrder": [
        "<THIRD_PARTY_MODULES>",
        "@/app/components/(.*)$",
        "@/app/styles/(.*)$",
        "@/app/hooks/(.*)$",
        "@/app/modules/(.*)$",
        "@/app/services/(.*)$",
        "@/app/helpers/(.*)$",
        "@/app/shared/(.*)$",
        "^../(.*)",
        "^./(.*)",
        "(.scss)$"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "plugins": ["@trivago/prettier-plugin-sort-imports"]
}
